# ==============================================================================
# ARDUINO BOARD - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and configure your credentials:
# cp .env.local.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Create a free project at https://supabase.com
# Find these in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ------------------------------------------------------------------------------
# 2. AI PROGRAMMING ASSISTANT
# ------------------------------------------------------------------------------
# Google Gemini API Key (Get at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Groq API Key (Get at: https://console.groq.com/keys)
GROQ_API_KEY=
